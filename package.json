{
  "name": "eakta-viewer",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "prestart": "npm run verifier",
    "start": "react-native start",
    "verifier": "tsx scripts/build-verifier.ts",
    "source-policy": "tsx scripts/assert-source-policy.ts",
    "lint": "eslint .",
    "format-check": "prettier --check .",
    "pretypecheck": "npm run verifier",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run verifier",
    "test": "jest",
    "commitlint": "commitlint --edit",
    "trust-update": "tsx scripts/update-trust-snapshot.ts"
  },
  "dependencies": {
    "asn1js": "3.0.10",
    "dompurify": "3.4.14",
    "fflate": "0.8.3",
    "lucide-react-native": "1.34.0",
    "pkijs": "3.4.0",
    "react": "19.2.8",
    "react-native": "0.81.6",
    "react-native-macos": "0.81.9",
    "react-native-svg": "15.15.5",
    "react-native-webview": "14.0.1",
    "tslib": "2.8.1",
    "xadesjs": "2.6.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "7.29.7",
    "@babel/preset-env": "^8.0.2",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "9.39.5",
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@react-native/typescript-config": "0.81.6",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "19.1.0",
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "xpath": "0.0.34"
  },
  "engines": {
    "node": "24.x"
  },
  "codegenConfig": {
    "name": "EaktaViewerSpec",
    "type": "all",
    "jsSrcsDir": "src/native/specs",
    "ios": {
      "componentProvider": {
        "QuickLookPreview": "QuickLookPreviewComponentView"
      },
      "modulesProvider": {
        "ES3MacBridge": "ES3MacBridge"
      }
    }
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
